# Required provider API keys — replace placeholders with your own credentials.
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Required to protect the document-ingestion endpoint; choose a strong random value.
ADMIN_API_KEY=replace_with_a_strong_secret

# Optional application settings (defaults are shown).
APP_ENV=development
PINECONE_INDEX_NAME=fde-hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=4
MAX_RETRIES=1
